---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import ProjectOverview from "@components/ProjectOverview";
import { projects } from "@data/projects";
---

<Layout
  title="2martens.de"
  description="2martens.de - The official website of Jim Martens"
  appName="2martens.de"
  logoTitle="Jim Martens"
  activeItem="Projekte"
>
  <ProjectOverview>
    <figure class="relative border-none h-full overflow-hidden bg-background dark:bg-background-dark rounded-xl shadow-xl lg:-mr-36" slot="image">
      <Image src={projects[0].image} alt={projects[0].imageAltText} 
      class="absolute inset-0 h-full w-auto max-w-none object-cover rounded-xl"
      />
    </figure>
  </ProjectOverview>
</Layout>

---
import SimpleLayout from "../layouts/SimpleLayout.astro";

---
<SimpleLayout
        appName="2martens.de"
        title="Sieve Script Editor Support"
        description="2martens.de - The official website of Jim Martens"
>
    <div class="bg-background-secondary px-6 py-16 lg:px-8">
        <div class="mx-auto max-w-3xl text-base/7 text-body-secondary">
            <h1 class="text-4xl font-semibold tracking-tight text-pretty sm:text-5xl">Sieve Script Editor Support</h1>

            <h2 class="mt-6 text-2xl font-semibold tracking-tight text-pretty sm:text-2xl">Contact:</h2>
            <p>E-Mail: appsupport@2martens.de</p>
        </div>
    </div>
</SimpleLayout>